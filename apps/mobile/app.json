{
  "expo": {
    "name": "Apsis",
    "slug": "apsis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apsis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apsis.app",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Apsis uses the camera only to scan food barcodes and photograph nutrition labels so you can log foods faster."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.apsis.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0E"
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Apsis reads your runs, heart rate, and bodyweight from Health so they count toward your training load automatically.",
          "NSHealthUpdateUsageDescription": "Apsis writes your logged lifting and running sessions to Health so they show up alongside your other workouts.",
          "background": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Apsis uses the camera only to scan food barcodes and photograph nutrition labels so you can log foods faster.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "apsis-training",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Apsis uses your photo library only to let you pick a background photo for a share card image."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82297c64-339f-4d96-9345-d19f46974203"
      }
    },
    "owner": "apsis"
  }
}
